[Unit]
Description=Voice agent (persistent Haiku assistant for Right Shift commands)
After=pipewire.service

[Service]
ExecStart=%h/code/voice-agent/tts/venv/bin/python %h/code/voice-agent/voice_agent.py
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=3
Nice=10

[Install]
WantedBy=default.target
