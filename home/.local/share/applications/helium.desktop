[Desktop Entry]
Name=Helium
Exec=@HOME@/Applications/helium.AppImage --appimage-extract-and-run --enable-features=AcceleratedVideoDecodeLinuxGL,AcceleratedVideoDecodeLinuxZeroCopyGL,VaapiVideoDecoder,VaapiIgnoreDriverChecks %U
Type=Application
Terminal=false
Categories=Network;WebBrowser;
MimeType=text/html;x-scheme-handler/https;x-scheme-handler/http;
Icon=helium-browser
StartupWMClass=helium
