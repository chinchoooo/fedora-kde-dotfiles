#!/usr/bin/env python3
"""cc-status: ONE self-replacing KDE notification showing what Claude Code is doing right now.
Same style as the dictation popup (notify-send, reused id, never stacks), plus a live progress bar.

  cc-status "Transcribing audio" --pct 42 --eta 12m     manual update (used by Claude for long jobs)
  cc-status --done "Subtitles ready"                    finish (auto-closes after a few seconds)
  cc-status --fail "Transcription crashed"              error (stays until dismissed)
  cc-status --hook                                      Claude Code hook mode (reads hook JSON on stdin)

Mute: touch ~/.cache/cc-status-off   (rm to re-enable)
"""
import json, os, subprocess, sys, time

RUN = os.environ.get("XDG_RUNTIME_DIR", "/run/user/1000")
STATE = os.path.join(RUN, "cc-status.json")
OFF = os.path.expanduser("~/.cache/cc-status-off")
MANUAL_TTL = 120          # a manual pct/eta survives hook updates for this many seconds


def load():
    try:
        with open(STATE) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def save(s):
    tmp = STATE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(s, f)
    os.replace(tmp, STATE)


def fmt(sec):
    sec = int(sec)
    return f"{sec // 60}m{sec % 60:02d}s" if sec >= 60 else f"{sec}s"


def bar(pct, n=14):
    k = round(pct * n / 100)
    return "▰" * k + "▱" * (n - k)


def show(s, action, pct=None, eta=None, level="run", timeout=0):
    if os.path.exists(OFF):
        return
    elapsed = time.time() - s.get("start", time.time())
    icon = {"run": "⏵", "done": "✓", "fail": "✕", "wait": "◔"}[level]
    head = {"run": "working", "done": "done", "fail": "failed", "wait": "needs you"}[level]
    title = f"Claude Code · {head} · {fmt(elapsed)}"
    body = f"{icon} {action}"
    if pct is not None:
        body += f"\n{bar(pct)} {pct}%"
    if eta:
        body += f"  ·  ~{eta} left"
    cmd = ["notify-send", "-p", "-a", "Claude Code", "-u", "critical" if level == "fail" else "low",
           "-t", str(timeout), "-e"]
    if s.get("nid"):
        cmd += ["-r", str(s["nid"])]
    if pct is not None:
        cmd += ["-h", f"int:value:{int(pct)}"]
    try:
        out = subprocess.run(cmd + [title, body], capture_output=True, text=True, timeout=5).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return
    if out.isdigit():
        s["nid"] = int(out)


def describe(d):
    t = d.get("tool_name", "")
    i = d.get("tool_input") or {}
    if t == "Bash":
        txt = i.get("description") or i.get("command", "")
        return "Running: " + " ".join(txt.split())[:60]
    if t in ("Read", "Edit", "Write", "NotebookEdit"):
        verb = {"Read": "Reading", "Edit": "Editing", "Write": "Writing"}.get(t, "Editing")
        return f"{verb} {os.path.basename(i.get('file_path', '') or i.get('notebook_path', ''))}"
    if t in ("Grep", "Glob"):
        return "Searching: " + str(i.get("pattern", ""))[:50]
    if t == "Agent":
        return "Subagent: " + str(i.get("description", ""))[:50]
    if t == "Monitor":
        return "Watching: " + str(i.get("description", ""))[:50]
    if t == "Skill":
        return "Skill: " + str(i.get("skill", ""))
    if t == "WebSearch" or t == "WebFetch":
        return "Looking it up on the web"
    return t or "Working"


def hook():
    try:
        d = json.load(sys.stdin)
    except ValueError:
        return
    ev = d.get("hook_event_name", "")
    s = load()
    now = time.time()
    if ev == "UserPromptSubmit":
        s = {"start": now, "nid": s.get("nid")}
        show(s, "Thinking…")
    elif ev == "PreToolUse":
        s.setdefault("start", now)
        fresh = now - s.get("manual_at", 0) < MANUAL_TTL
        show(s, describe(d), s.get("pct") if fresh else None, s.get("eta") if fresh else None)
    elif ev == "Notification":
        show(s, "Waiting for you", level="wait")
    elif ev == "Stop":
        show(s, "Finished", level="done", timeout=4000)
        s = {"nid": s.get("nid")}
    save(s)


def main():
    a = sys.argv[1:]
    if "--hook" in a:
        return hook()
    pct = eta = None
    level, timeout, words = "run", 0, []
    i = 0
    while i < len(a):
        if a[i] == "--pct":
            pct = max(0, min(100, int(float(a[i + 1])))); i += 1
        elif a[i] == "--eta":
            eta = a[i + 1]; i += 1
        elif a[i] == "--done":
            level, timeout = "done", 5000
        elif a[i] == "--fail":
            level = "fail"
        else:
            words.append(a[i])
        i += 1
    s = load()
    s.setdefault("start", time.time())
    action = " ".join(words) or "Working"
    if level == "run":
        s.update(pct=pct, eta=eta, manual_at=time.time())
    show(s, action, pct, eta, level, timeout)
    if level != "run":
        s = {"nid": s.get("nid")}
    save(s)


if __name__ == "__main__":
    main()
