#!/usr/bin/env python3
"""cc-status: publishes what Claude Code is doing right now to a state file that the
'Claude Status' Plasma panel widget (com.chinchoo.ccstatus) renders live.
A desktop popup is shown ONLY when attention is needed (done / failed / waiting for you).

  cc-status "Transcribing audio" --pct 42 [--eta 12m]   progress update (ETA is computed from the rate if omitted)
  cc-status --done "Subtitles ready"                    finished   (popup, widget shows a check, then idles)
  cc-status --fail "Transcription crashed"              error      (popup stays until dismissed)
  cc-status --idle                                      clear
  cc-status --hook                                      Claude Code hook mode (reads hook JSON on stdin)

Mute popups: touch ~/.cache/cc-status-off      State file: $XDG_RUNTIME_DIR/cc-status.json
"""
import json, os, subprocess, sys, time

RUN = os.environ.get("XDG_RUNTIME_DIR", "/run/user/1000")
STATE = os.path.join(RUN, "cc-status.json")
OFF = os.path.expanduser("~/.cache/cc-status-off")
MANUAL_TTL = 180          # a manual pct survives hook-driven action changes for this long


def load():
    try:
        with open(STATE) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def save(s):
    s["updated"] = time.time()
    tmp = STATE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(s, f)
    os.replace(tmp, STATE)


def fmt(sec):
    sec = int(sec)
    return f"{sec // 3600}h{sec % 3600 // 60:02d}m" if sec >= 3600 else f"{sec // 60}m{sec % 60:02d}s" if sec >= 60 else f"{sec}s"


def popup(s, title, body, urgency="low", timeout=5000):
    if os.path.exists(OFF):
        return
    cmd = ["notify-send", "-p", "-a", "Claude Code", "-u", urgency, "-t", str(timeout), "-e"]
    if s.get("nid"):
        cmd += ["-r", str(s["nid"])]
    try:
        out = subprocess.run(cmd + [title, body], capture_output=True, text=True, timeout=5).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return
    if out.isdigit():
        s["nid"] = int(out)


def describe(d):
    t = d.get("tool_name", "")
    i = d.get("tool_input") or {}
    if t == "Bash":
        return "Running: " + " ".join((i.get("description") or i.get("command", "")).split())[:60]
    if t in ("Read", "Edit", "Write", "NotebookEdit"):
        verb = {"Read": "Reading", "Write": "Writing"}.get(t, "Editing")
        return f"{verb} {os.path.basename(i.get('file_path', '') or i.get('notebook_path', ''))}"
    if t in ("Grep", "Glob"):
        return "Searching: " + str(i.get("pattern", ""))[:50]
    if t == "Agent":
        return "Subagent: " + str(i.get("description", ""))[:50]
    if t == "Monitor":
        return "Watching: " + str(i.get("description", ""))[:50]
    if t == "Skill":
        return "Skill: " + str(i.get("skill", ""))
    if t in ("WebSearch", "WebFetch"):
        return "Looking it up on the web"
    return t or "Working"


def set_progress(s, pct, now):
    """Track pct so the widget can derive a rate-based ETA."""
    if pct is None:
        return
    if s.get("pct") is None or pct < s.get("pct", 0) or "p0" not in s:
        s["p0"], s["p0_at"] = pct, now
    s["pct"], s["pct_at"] = pct, now


def hook():
    try:
        d = json.load(sys.stdin)
    except ValueError:
        return
    ev = d.get("hook_event_name", "")
    s = load()
    now = time.time()
    nid = s.get("nid")
    if ev == "UserPromptSubmit":
        s = {"nid": nid, "state": "run", "action": "Thinking…", "start": now}
    elif ev == "PreToolUse":
        if s.get("state") != "run" or not s.get("start"):
            s = {"nid": nid, "state": "run", "start": now}
        if now - s.get("manual_at", 0) > MANUAL_TTL:
            for k in ("pct", "p0", "p0_at", "pct_at", "eta"):
                s.pop(k, None)
        s["action"] = describe(d)
        s["tool_start"] = now
    elif ev == "Notification":
        s["state"], s["action"] = "wait", "Waiting for you"
        popup(s, "Claude Code needs you", d.get("message", "Waiting for your input"), "normal", 8000)
    elif ev == "Stop":
        el = now - s.get("start", now)
        s = {"nid": nid, "state": "done", "action": "Finished", "start": s.get("start", now), "end": now}
        if el > 60:                                    # only pop up for work that took a while
            popup(s, "Claude Code · done", f"Finished in {fmt(el)}", "low", 4000)
    save(s)


def main():
    a = sys.argv[1:]
    if "--hook" in a:
        return hook()
    pct = eta = None
    mode, words = "run", []
    i = 0
    while i < len(a):
        if a[i] == "--pct":
            pct = max(0, min(100, int(float(a[i + 1])))); i += 1
        elif a[i] == "--eta":
            eta = a[i + 1]; i += 1
        elif a[i] in ("--done", "--fail", "--idle"):
            mode = a[i][2:]
        else:
            words.append(a[i])
        i += 1
    s = load()
    now = time.time()
    action = " ".join(words)
    if mode == "idle":
        save({"state": "idle", "nid": s.get("nid")}); return
    if mode in ("done", "fail"):
        el = now - s.get("start", now)
        s = {"nid": s.get("nid"), "state": mode, "action": action or ("Finished" if mode == "done" else "Failed"),
             "start": s.get("start", now), "end": now}
        popup(s, f"Claude Code · {'done' if mode == 'done' else 'FAILED'} · {fmt(el)}", s["action"],
              "low" if mode == "done" else "critical", 5000 if mode == "done" else 0)
        save(s); return
    if s.get("state") != "run" or not s.get("start"):
        s = {"nid": s.get("nid"), "start": now}
    s["state"] = "run"
    if action:
        s["action"] = action
    set_progress(s, pct, now)
    if eta:
        s["eta"] = eta
    s["manual_at"] = now
    save(s)


if __name__ == "__main__":
    main()
