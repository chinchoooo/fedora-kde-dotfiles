#!/bin/bash
# On-device speech: Kokoro-82M (int8) at low priority; falls back to Piper if Kokoro is unavailable. usage: speak "text" (or pipe text in)
D=$HOME/code/voice-agent/tts
T="${*:-$(cat)}"
if [ -f "$D/kokoro/kokoro-v1.0.int8.onnx" ]; then
  printf '%s' "$T" | nice -n 19 "$D/venv/bin/python" "$D/kspeak.py" && exit 0
fi
exec "$HOME/.local/bin/speak-piper" "$T"
