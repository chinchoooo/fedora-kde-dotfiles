#!/bin/bash
# Konsole left half, Helium right half (KWin script)
J=$HOME/.local/share/tile-split.js
busctl --user call org.kde.KWin /Scripting org.kde.kwin.Scripting unloadScript s tilesplit >/dev/null 2>&1
ID=$(busctl --user call org.kde.KWin /Scripting org.kde.kwin.Scripting loadScript ss "$J" tilesplit | awk '{print $2}')
busctl --user call org.kde.KWin /Scripting/Script$ID org.kde.kwin.Script run >/dev/null 2>&1
