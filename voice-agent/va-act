MPRIS = {"play": "Play", "pause": "Pause", "toggle": "PlayPause", "next": "Next", "previous": "Previous", "stop": "Stop"}


def players():
    out = run(["busctl", "--user", "list", "--no-legend"])
    return [l.split()[0] for l in out.splitlines() if l.startswith("org.mpris.MediaPlayer2.")]


def pick_player():
    ps = players()
    for p in ps:                                 # prefer one that is playing
        if "Playing" in run(["busctl", "--user", "get-property", p, "/org/mpris/MediaPlayer2", "org.mpris.MediaPlayer2.Player", "PlaybackStatus"]):
            return p
    return ps[0] if ps else None


def cmd_media(a):
    p = pick_player()
    if not p:
        fail("no media player is running")
    subprocess.run(["busctl", "--user", "call", p, "/org/mpris/MediaPlayer2", "org.mpris.MediaPlayer2.Player", MPRIS[a.action]],
                   capture_output=True, timeout=10)
    print("media " + a.action + " sent to " + p.replace("org.mpris.MediaPlayer2.", ""))


def cmd_now_playing(a):
    p = pick_player()
    if not p:
        print("nothing is playing (no media player running)")
        return
    st = re.sub(r'^s "|"$', "", run(["busctl", "--user", "get-property", p, "/org/mpris/MediaPlayer2", "org.mpris.MediaPlayer2.Player", "PlaybackStatus"]))
    out = run(["busctl", "--user", "--json=short", "get-property", p, "/org/mpris/MediaPlayer2", "org.mpris.MediaPlayer2.Player", "Metadata"])
    try:
        md = json.loads(out)["data"]
        g = lambda k: (md.get(k) or {}).get("data")
        title, artist = g("xesam:title"), g("xesam:artist")
        print(f"{st}: {title} by {', '.join(artist) if artist else 'unknown artist'} ({p.replace('org.mpris.MediaPlayer2.', '')})")
    except Exception:
        print(f"{st}: unknown track ({p})")


def cmd_volume(a):
    v = a.value.lower()
    if v == "up":
        run(["wpctl", "set-volume", "-l", "1.0", SINK, "5%+"])
    elif v == "down":
        run(["wpctl", "set-volume", SINK, "5%-"])
    elif v in ("mute", "unmute"):
        run(["wpctl", "set-mute", SINK, "1" if v == "mute" else "0"])
    elif v.isdigit() and 0 <= int(v) <= 100:
        run(["wpctl", "set-volume", SINK, f"{int(v)}%"])
    else:
        fail("volume must be up, down, mute, unmute or 0-100")
    cmd_get_volume(a)


def cmd_get_volume(a):
