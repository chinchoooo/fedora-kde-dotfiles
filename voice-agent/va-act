def cmd_brightness(a):
    v = a.value.lower()
    if v == "up":
        arg = "+10%"
    elif v == "down":
        arg = "10%-"
    elif v.isdigit() and 1 <= int(v) <= 100:
        arg = f"{int(v)}%"
    else:
        fail("brightness must be up, down or 1-100")
    run(["brightnessctl", "-q", "set", arg])
    cur, mx = run(["brightnessctl", "get"]), run(["brightnessctl", "max"])
    print(f"brightness {round(100 * int(cur) / int(mx))}%")


def draw_grid(path, logical):
    """Overlay a labelled coordinate grid (every 100 px, in logical screen pixels = the coordinates `click` uses)."""
    from PIL import Image, ImageDraw, ImageFont
    im = Image.open(path).convert("RGBA")
    if logical and im.size != tuple(logical):
        im = im.resize(tuple(logical))
    W, H = im.size
    ov = Image.new("RGBA", im.size, (0, 0, 0, 0))
    d = ImageDraw.Draw(ov)
    try:
        font = ImageFont.load_default(size=13)
    except TypeError:
        font = ImageFont.load_default()
    for x in range(0, W, 100):
        d.line([(x, 0), (x, H)], fill=(255, 0, 80, 110 if x % 500 else 190), width=1)
    for y in range(0, H, 100):
        d.line([(0, y), (W, y)], fill=(255, 0, 80, 110 if y % 500 else 190), width=1)

    def label(x, y, t):
        x = min(max(x, 0), W - 44); y = min(max(y, 0), H - 16)
        d.rectangle([x, y, x + 8 * len(t) + 2, y + 15], fill=(0, 0, 0, 170))
        d.text((x + 2, y + 1), t, fill=(255, 255, 0, 255), font=font)
    for x in range(0, W, 100):
        label(x + 2, 0, str(x)); label(x + 2, H - 16, str(x))
    for y in range(0, H, 100):
        label(0, y + 2, str(y)); label(W - 44, y + 2, str(y))
    for x in range(200, W, 200):
        for y in range(200, H, 200):
            label(x + 2, y + 2, f"{x},{y}")
    Image.alpha_composite(im, ov).convert("RGB").save(path)


def cmd_screenshot(a):
    os.makedirs(SHOTS, mode=0o700, exist_ok=True)
    for f in glob.glob(SHOTS + "/*.png"):      # keep the directory tidy: drop shots older than 1 hour
        if time.time() - os.path.getmtime(f) > 3600:
            os.unlink(f)
    path = f"{SHOTS}/shot-{'grid-' if a.grid else ''}{int(time.time() * 1000)}.png"
    subprocess.run(["spectacle", "-b", "-n", "-f", "-o", path], capture_output=True, timeout=30)
    if not os.path.exists(path):
        fail("screenshot failed")
    if a.grid:
        sys.path.insert(0, HERE)
        import va_gui
        try:
            _, scr = va_gui.screen_and_window()
            draw_grid(path, scr)
        except Exception as e:
            fail("could not draw the grid: " + str(e))
    print(path)


