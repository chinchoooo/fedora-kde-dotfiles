def cmd_focus(a):
    q = " ".join(a.query).strip().lower()
    if not re.fullmatch(r"[\w .:+/-]{1,60}", q):
        fail("window name may only contain letters, digits and . : + / - and spaces")
    sys.path.insert(0, HERE)
    import va_gui
    try:
        if va_gui.panic_active():
            raise va_gui.Refused("stopped by the user (panic stop)")
        va_gui.require_armed()
    except va_gui.Refused as e:
        va_gui.log_action("focus", q, None, "REFUSED: " + str(e)); print("refused: " + str(e)); sys.exit(3)
    if va_gui.dry():
        va_gui.log_action("focus", q, None, "DRY"); print("DRY would focus a window matching " + q); return
    t = va_gui.kwin_eval(FOCUS_JS % json.dumps(q))
    va_gui.log_action("focus", q, {"cls": "-", "title": t or ""}, "ok" if t else "no match")
    print(("focused: " + t[:120]) if t else "no window matches " + q)


BROWSER_SIMPLE = {"close-tab": "ctrl+w", "new-tab": "ctrl+t", "next-tab": "ctrl+tab", "prev-tab": "ctrl+shift+tab",
                  "reopen-closed": "ctrl+shift+t", "reload": "ctrl+r", "back": "alt+left", "forward": "alt+right",
                  "fullscreen": "f11"}
BROWSER_ACTIONS = list(BROWSER_SIMPLE) + ["goto-tab", "search-tab", "find", "mute-site", "close-tabs-matching"]


def cmd_browser(a):
    def f(g):
        act, text = a.action, " ".join(a.text).strip()
        if act in BROWSER_SIMPLE:
            g.gate("browser " + act, "", require_browser=True)
            g.send_combo(BROWSER_SIMPLE[act])
            print(act + " done; take a screenshot to verify")
        elif act == "goto-tab":
            if not text.isdigit() or not 1 <= int(text) <= 9:
                raise g.Refused("goto-tab needs a number 1-9 (9 is the last tab)")
            g.gate("browser goto-tab", text, require_browser=True)
            g.send_combo("ctrl+" + text)
            print("switched to tab " + text)
        elif act in ("search-tab", "find"):
            text = g.validate_text(text, 100)
            g.gate("browser " + act, text, cost=3, require_browser=True)
            g.send_combo("ctrl+shift+a" if act == "search-tab" else "ctrl+f")
            time.sleep(0.5)
            g.send_text(text)
            time.sleep(0.4)
            g.send_combo("enter")
            print(act + " for " + text + " done; take a screenshot to verify")
        elif act == "mute-site":
            raise g.Refused("the browser has no keyboard shortcut to mute a site; use `va-act media pause` or `va-act volume mute`")
        elif act == "close-tabs-matching":
            close_tabs_matching(g, g.validate_text(text, 60).lower())
    gui(f)


def close_tabs_matching(g, needle, max_close=15, max_steps=45):
    """Walk the tabs with Ctrl+Tab; close the active tab when its window title contains `needle`. Verified by re-reading the
    title after each key press. Tabs whose title looks sensitive are skipped, never touched. Stops after 15 closes."""
    win, _ = g.gate("browser close-tabs-matching", needle, require_browser=True)
    if g.dry():
        print(f"DRY would close up to {max_close} tabs whose title contains {needle!r} and then take a verification screenshot")
        return
    closed, seen, steps = 0, {}, 0
    while closed < max_close and steps < max_steps:
        win, _ = g.screen_and_window()
        title = (win or {}).get("title", "")
        if g.check_window(win) and not any(b in ((win or {}).get("cls", "")).lower() for b in g.BROWSER_CLASSES):
            print("stopped: the active window changed to something blocked"); break
        low = title.lower()
        if needle in low and not g.check_window(win):
            g.gate("browser close-tab(loop)", needle, require_browser=True)
            g.send_combo("ctrl+w"); time.sleep(0.35)
            win2, _ = g.screen_and_window()
            if (win2 or {}).get("title", "") == title:
                print("stopped: the tab did not close"); break
            closed += 1; seen.clear()
            print(f"closed: {title[:60]}")
            continue
        seen[low] = seen.get(low, 0) + 1
        if seen[low] > 1:
            break                                         # went all the way round
        g.send_combo("ctrl+tab"); time.sleep(0.3); steps += 1
    print(f"closed {closed} tab(s); checking the screen")
    cmd_screenshot(argparse.Namespace(grid=False))


WORKSPACE = os.path.expanduser("~/va-workspace")
OPEN_EXT = {".txt", ".md", ".html", ".htm", ".pdf", ".png", ".jpg", ".jpeg", ".gif", ".svg", ".webp", ".csv", ".json", ".odt", ".ods",
            ".odp", ".docx", ".xlsx", ".pptx", ".mp3", ".mp4", ".wav", ".ogg", ".webm", ".mkv", ".log", ".css", ".js", ".xml", ".yaml", ".yml"}


def workspace_path(p):
    os.makedirs(WORKSPACE, exist_ok=True)
    rp = os.path.realpath(os.path.expanduser(p) if p.startswith("~") else os.path.join(WORKSPACE, p) if not os.path.isabs(p) else p)
    if rp != WORKSPACE and not rp.startswith(WORKSPACE + os.sep):
        fail("path must be inside ~/va-workspace")
    return rp


def need_armed():
    sys.path.insert(0, HERE)
    import va_gui
    try:
        va_gui.require_armed()
    except va_gui.Refused as e:
        print("refused: " + str(e)); sys.exit(3)


def cmd_open_file(a):
    need_armed()
    rp = workspace_path(" ".join(a.path))
    if not os.path.exists(rp):
        fail("no such file in ~/va-workspace")
    if os.path.isfile(rp):
        if os.access(rp, os.X_OK) or os.path.splitext(rp)[1].lower() not in OPEN_EXT:
            fail("that file type is not opened by the agent (executables and scripts are never opened)")
    detach(["xdg-open", rp])
    print("opened " + os.path.relpath(rp, WORKSPACE))


def cmd_make_folder(a):
    need_armed()
    rp = workspace_path(" ".join(a.path))
    os.makedirs(rp, exist_ok=True)
    print("folder ready: " + os.path.relpath(rp, WORKSPACE))


COMMANDS = {}


def build():
    ap = argparse.ArgumentParser(prog="va-act", description=__doc__)
    sp = ap.add_subparsers(dest="cmd", required=True)

    def add(name, fn, *args, **kw):
        p = sp.add_parser(name)
        for n, kwargs in args:
            p.add_argument(n, **kwargs)
        p.set_defaults(fn=fn)
    add("open-url", cmd_open_url, ("url", {}))
    add("search", cmd_search, ("query", {"nargs": "+"}))
    add("launch-app", cmd_launch_app, ("name", {"nargs": "+"}))
    add("media", cmd_media, ("action", {"choices": list(MPRIS)}))
    add("now-playing", cmd_now_playing)
    add("volume", cmd_volume, ("value", {}))
    add("get-volume", cmd_get_volume)
    add("brightness", cmd_brightness, ("value", {}))
    add("screenshot", cmd_screenshot, ("--grid", {"action": "store_true"}))
    add("key", cmd_key, ("combo", {}))
    add("type", cmd_type, ("text", {"nargs": "+"}))
    add("click", cmd_click, ("x", {"type": int}), ("y", {"type": int}), ("kind", {"nargs": "?", "default": "left", "choices": ["left", "right", "double"]}))
    add("move", cmd_move, ("x", {"type": int}), ("y", {"type": int}))
    add("scroll", cmd_scroll, ("direction", {"choices": ["up", "down"]}), ("n", {"type": int}))
    add("active-window", cmd_active_window)
    add("focus", cmd_focus, ("query", {"nargs": "+"}))
    add("browser", cmd_browser, ("action", {"choices": BROWSER_ACTIONS}), ("text", {"nargs": "*"}))
    add("open-file", cmd_open_file, ("path", {"nargs": "+"}))
    add("make-folder", cmd_make_folder, ("path", {"nargs": "+"}))
    add("notify", cmd_notify, ("text", {"nargs": "+"}))
    add("speak", cmd_speak, ("text", {"nargs": "+"}))
    add("tile-split", cmd_tile_split)
    add("time", cmd_time)
    add("windows", cmd_windows)
    add("battery", cmd_battery)
    add("wifi-status", cmd_wifi_status)
    return ap


if __name__ == "__main__":
    a = build().parse_args()
    try:
        a.fn(a)
    except subprocess.TimeoutExpired:
        fail("timed out")
